DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/tecsecure"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
# Optional dedicated at-rest encryption key; defaults to NEXTAUTH_SECRET when unset.
INTEGRATION_CREDENTIALS_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# Optional social sign-in. Provider buttons appear only when all credentials
# for that provider and NEXTAUTH_SECRET are configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
YANDEX_CLIENT_ID=""
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""
YANDEX_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Second Telegram bot for staff. Leave empty to run everything through the single bot above.
TELEGRAM_STAFF_BOT_TOKEN=""
TELEGRAM_STAFF_BOT_USERNAME=""
TELEGRAM_STAFF_WEBHOOK_SECRET=""

# Payme online card payments. Both must be set before the option appears at checkout.
PAYME_MERCHANT_ID=""
PAYME_KEY=""
# "1" uses Payme's test checkout.
PAYME_TEST_MODE=""

# SMS sign-in codes through Eskiz. Without them, codes go only to a linked Telegram.
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# Password-reset email through Resend.
RESEND_API_KEY=""
MAIL_FROM=""

# Yandex Metrika counter. Loads only for visitors who accept analytics cookies.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""
